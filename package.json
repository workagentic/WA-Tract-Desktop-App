{
  "name": "desktop_app",
  "version": "1.0.4",
  "description": "WA Track desktop app (Electron + React + TypeScript)",
  "main": "./out/main/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development electron-vite dev",
    "build": "cross-env NODE_ENV=production electron-vite build",
    "start": "cross-env NODE_ENV=production electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "cross-env NODE_ENV=production electron-vite build && electron-builder --win",
    "dist:win:fast": "cross-env NODE_ENV=production electron-vite build && electron-builder --win dir",
    "dist:win:watch": "nodemon --watch src --ext ts,tsx --delay 3 --exec \"npm run dist:win:fast\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "jwt-decode": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "nodemon": "^3.1.14",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.workagentic.watrack",
    "productName": "WA Track",
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "workAgentic",
        "repo": "WA-Tract-Desktop-App",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      ".env.production"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "WA-Track-Setup.${ext}"
    }
  }
}
